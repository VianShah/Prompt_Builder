# ---- Required on Render ----
# Render Postgres connection string (render.yaml wires this automatically).
DATABASE_URL=
# Long random string used to sign login cookies (render.yaml generates one).
SESSION_SECRET=
# Who can sign in: email|Name|role|password, comma-separated. role = editor | approver | admin.
# Editors create and fix prompts; approvers approve, take versions live and roll back.
BUILDER_USERS=admin@example.com|Admin Name|admin|change-me,approver@example.com|Approver Name|approver|change-me


# ---- AI ----
# Tried in LLM_ORDER. Missing keys are skipped; with none, feedback is mapped by keyword rules and drafting is off.
LLM_ORDER=claude,glm,gemini
# Claude Sonnet 5.5 on the team's AWS Bedrock. Get the Bedrock API key from Anjani privately; never commit it.
# Global inference profile: requests may be served outside India.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=ap-south-1
CLAUDE_MODEL=global.anthropic.claude-sonnet-5-5
GLM_BEDROCK_API_KEY=
GLM_BEDROCK_BASE_URL=https://bedrock-runtime.ap-south-1.amazonaws.com/openai/v1
GLM_MODEL=zai.glm-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# How approved prompts reach Sarvam. Only "manual" exists today (paste into Sarvam Canvas, commit, confirm here).
SARVAM_PROMPT_PUSH=manual

# Sarvam Voice Agents API key (Sarvam > Voice Agents > Settings > API key). Reads calls, transcripts and recordings for the Calls tab.
# Unlike the Sarvam sign-in (about 24 hours), it does not expire daily. It cannot read prompts.
SARVAM_API_KEY=

# Sarvam workspace ids (from the Sarvam Voice Agents URL).
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=

# Module library: JSON files in library/modules/ of the git repo. Leave GITHUB_TOKEN empty locally
# (files are written to this folder; commit them). On Render set a fine-grained GitHub token with
# Contents: read and write on this repo: every module save is committed to GITHUB_LIBRARY_BRANCH.
GITHUB_TOKEN=
GITHUB_REPO=VianShah/Prompt_Builder
GITHUB_LIBRARY_BRANCH=module-library

# true: the engineer who builds an agent also approves it. false: a second person must approve.
SELF_APPROVE=true
